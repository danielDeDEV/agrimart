{
  "name": "agrimarket-backend",
  "version": "1.0.0",
  "description": "AgriMart Ghana - Integrated USSD/SMS Web-Based Platform for Smallholder Farmers. REST API, USSD state machine, SMS gateway and realtime services.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/run.mjs",
    "setup": "node src/scripts/setup.js",
    "db:production": "node src/scripts/production.js",
    "db:sync": "node src/scripts/sync.js",
    "db:seed": "node src/scripts/seed.js",
    "db:reset": "node src/scripts/reset.js",
    "db:migrate-postgres": "node src/scripts/migrateToPostgres.js",
    "purge:demo": "node src/scripts/purgeDemo.js",
    "check:env": "node src/scripts/checkEnv.js",
    "check:live": "node src/scripts/checkLive.js",
    "backup": "node src/scripts/backup.js",
    "photos:sync": "node src/scripts/syncPhotos.js",
    "gateway:check": "node src/scripts/gateway.js check",
    "gateway:test": "node src/scripts/gateway.js test",
    "gateway:ussd": "node src/scripts/gateway.js ussd"
