# Keep Unix line endings on anything the server executes or reads, so a
# checkout on Windows does not deliver "bad interpreter: bash^M" to Linux.
*.sh            text eol=lf
*.service       text eol=lf

# Windows helpers stay CRLF so cmd.exe and Notepad read them properly
*.bat           text eol=crlf

*               text=auto
*.jpg           binary
*.jpeg          binary
*.png           binary
*.webp          binary
*.sql           binary
