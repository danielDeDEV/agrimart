# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=AgriMart Ghana
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
# Extra browser origins allowed to call this API (comma separated): the bare
# domain, a staging site, an admin subdomain. In production, localhost is not
# allowed unless you list it here.
CLIENT_URLS=

# ── Database (PostgreSQL) ─────────────────────────────────
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agrimarket
DB_USER=agrimart
DB_PASSWORD=
DB_LOGGING=false
# Hosted Postgres (Neon, Supabase, Render…) requires TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# A single connection string wins over the parts above, which is how most
# hosts hand it to you:  postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# A production server never reshapes live tables on boot. Set DB_SYNC=true for
# one deploy if you have added a table, or run "npm run db:sync" deliberately.
DB_SYNC=false
DB_SYNC_ALTER=false

# ── The old MySQL database (migration only) ───────────────
# Read by "npm run db:migrate-postgres" to copy the existing data across.
# Delete these once the migration is done and verified.
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=agrimarket
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=


# ── Security ──────────────────────────────────────────────
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── USSD Gateway ──────────────────────────────────────────
# Quote the code: an unquoted # would be read as a comment and cut it off.
USSD_SERVICE_CODE="*920*1234#"
USSD_SESSION_TIMEOUT=180
USSD_PROVIDER=africastalking

# The account the website's phone simulator may open. The simulator is a
# sandbox: it never writes and never sends SMS, and it refuses any other
# registered number so nobody can guess a farmer's PIN from a browser.
USSD_DEMO_PHONES=0244100200,0244200300

# Where Africa's Talking reaches this server. On a laptop, run ngrok and paste
# the https URL it prints (e.g. https://ab12cd34.ngrok-free.app).
PUBLIC_URL=http://localhost:5000

# Optional shared secret. Set it here, then add ?secret=THE_SAME_VALUE to the
# callback URLs in the Africa's Talking dashboard. Empty = callbacks are open.
GATEWAY_SECRET=

# ── SMS Gateway ───────────────────────────────────────────
# provider: mock | africastalking | hubtel | mnotify | twilio
# mock writes messages to the SMS centre without sending or billing anything.
SMS_PROVIDER=mock
# Empty until your gateway approves a sender ID
SMS_SENDER_ID=
SMS_ENABLED=true

# Safe mode. While your database still has demo accounts, list the numbers
# that may receive real SMS (comma separated). Everyone else's messages are
# logged as "skipped" and never reach the gateway. Empty = send to everyone.
SMS_ALLOWLIST=

# Africa's Talking — https://account.africastalking.com → Settings → API Key
AT_API_KEY=
# Your app's username; "sandbox" for the test environment
AT_USERNAME=sandbox
# true forces the sandbox host (implied when AT_USERNAME=sandbox)
AT_SANDBOX=true
# The short code farmers text, if you have one (e.g. 1234)
AT_SHORT_CODE=

# Hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# mNotify (Ghana)
MNOTIFY_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Platform rules ────────────────────────────────────────
PLATFORM_COMMISSION_RATE=0.03
DEFAULT_CURRENCY=GHS
COUNTRY_CODE=233

# ── Uploaded files ────────────────────────────────────────
# Farmers' listing photos, avatars, and the screenshots people attach to
# payment disputes.
#
#   local     written to agrimarket-backend/uploads — right for a server with
#             its own disk
#   supabase  written to object storage — required on any hosted platform,
#             where the disk is wiped on every deploy and a farmer's dispute
#             evidence would vanish with it
#
# Empty picks supabase when a bucket is configured, otherwise local.
STORAGE_DRIVER=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# ── Logs ──────────────────────────────────────────────────
# In production, warnings and errors are also written to a file per day so they
# survive a restart. Empty = agrimarket-backend/logs. Setting it in development
# turns file logging on there too.
LOG_DIR=
LOG_KEEP_DAYS=14

# ── Backups ───────────────────────────────────────────────
# Where "npm run backup" writes. Point it off this machine.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Only needed if mysqldump is not on PATH (XAMPP: C:/xampp/mysql/bin/mysqldump.exe)
MYSQLDUMP_PATH=

# ── Seed admin ────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@agrimart.gh
SEED_ADMIN_PASSWORD=Admin@2026
SEED_ADMIN_PHONE=0244000000
