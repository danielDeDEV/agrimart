# Dependencies
node_modules/

# Secrets. .env holds the gateway API key, the JWT secrets and the database
# password — it must never be committed. .env.example is the template to copy.
.env
.env.*
!.env.example

# Farmers' own photos and evidence screenshots belong in storage, not here
uploads/**/*
!uploads/**/.gitkeep

# Database dumps hold real accounts, password hashes and phone numbers
backups/
*.sql
*.dump

# Logs
logs/
*.log
npm-debug.log*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
